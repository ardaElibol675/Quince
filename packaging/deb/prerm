#!/bin/sh
# Stops every running Quince (the service, its windows and editors) of every user before the
# files go away, so a removed or upgraded package leaves no service running on old code.
set -e

PATTERN='^/opt/quince/bin/python3 -I -m quince( |$)'

case "$1" in
    remove|upgrade|deconfigure|failed-upgrade)
        if pkill -TERM -f "$PATTERN"; then
            # Running jobs are cancelled and their temporary files removed; give them 5 s.
            i=0
            while pgrep -f "$PATTERN" >/dev/null && [ "$i" -lt 50 ]; do
                sleep 0.1
                i=$((i + 1))
            done
            pkill -KILL -f "$PATTERN" || true
        fi
        ;;
esac

exit 0
